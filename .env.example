# La app crea este archivo sola desde "Configuración". Solo hace falta editarlo a mano
# para activar el modo de prueba.
ARCA_CUIL='XXXXXXXXXXX'
DOWNLOAD_PATH='C:/Users/{user}/Documents/MisFacturas'

# Motor de facturación: web (navegador automático) o api (web service WSFEv1)
ARCA_MOTOR='web'

# --- Motor web ---
ARCA_KEY='XXXXXXXXXXX'

# --- Motor api ---
ARCA_CONDICION='monotributo'   # monotributo | ri
ARCA_AMBIENTE='produccion'     # produccion | homologacion
ARCA_PTO_VTA='1'
ARCA_ALICUOTA='21'             # solo Responsable Inscripto
ARCA_CERT='C:/ruta/certificado.crt'
ARCA_PRIVATE_KEY='C:/ruta/clave.key'
EMISOR_NOMBRE=''
EMISOR_DOMICILIO=''
EMISOR_IIBB=''
EMISOR_INICIO=''

# DEBUG=1 no emite: el motor web muestra el navegador y frena antes de confirmar;
# el motor api se autentica y consulta la numeración, pero no pide el CAE.
# DEBUG=1
